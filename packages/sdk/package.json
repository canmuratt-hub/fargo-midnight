{
  "name": "@fargo/sdk",
  "version": "0.1.0",
  "description": "FARGO Plugin & API Integration SDK for Privacy-Preserving Commerce on Midnight Network",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "import": "./dist/gateway.js",
      "default": "./dist/gateway.js"
    }
  },
  "scripts": {
    "build": "node --input-type=module -e \"import fs from 'node:fs'; fs.rmSync('dist',{recursive:true,force:true});\" && tsc -p tsconfig.build.json",
    "start:gateway": "node ./dist/server-cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fargo/contract": "*",
    "@midnight-ntwrk/compact-runtime": "0.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
